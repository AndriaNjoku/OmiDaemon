# ==============================================================================
# OmiDaemon Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# LLM Provider Configuration (gemini, openai, or anthropic)
OMIDAEMON_LLM_PROVIDER=gemini
OMIDAEMON_LLM_API_KEY=your-api-key-here
OMIDAEMON_LLM_MODEL=gemini-2.5-flash

# Google Drive Source Directory (Path to folder where wearable transcripts sync)
# e.g. G:\My Drive\OmiTranscripts or C:\Users\user\Google Drive\WearableTranscripts
OMIDAEMON_DRIVE_PATH=C:\Users\andri\Google Drive\Transcripts

# State & Persistence
OMIDAEMON_STATE_DB=data/omidaemon_state.db

# Obsidian Output Vault Path
OMIDAEMON_OBSIDIAN_VAULT=C:\Users\andri\Documents\ObsidianVault
OMIDAEMON_OBSIDIAN_SUBDIR=Executive Briefs

# Email Configuration (Optional - for sending executive updates/notes)
OMIDAEMON_EMAIL_ENABLED=false
OMIDAEMON_EMAIL_SMTP_HOST=smtp.gmail.com
OMIDAEMON_EMAIL_SMTP_PORT=587
OMIDAEMON_EMAIL_USER=your-email@gmail.com
OMIDAEMON_EMAIL_PASS=your-app-password
OMIDAEMON_EMAIL_PARTNER=partner@company.com
OMIDAEMON_EMAIL_STAFF=team@company.com

# Presentation Slides Output Directory
OMIDAEMON_SLIDES_DIR=output/slides

# Calendar Output Directory (.ics proposals)
OMIDAEMON_CALENDAR_DIR=output/calendar
